# Shared local service addresses. Individual projects own their real .env files.
RAG_API_URL=http://localhost:8080
EVALOPS_BASE_URL=http://localhost:8000
AGENT_RUNTIME_URL=http://localhost:8765
PORTFOLIO_API_TOKEN=replace-with-a-long-local-demo-secret

# Producer-specific endpoints; export one in the matching producer process.
AGENT_EVALOPS_ENDPOINT=http://localhost:8000/v1/ingest/agent/v1
RAG_EVALOPS_ENDPOINT=http://localhost:8000/v1/ingest/rag/v1
